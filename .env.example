# Payment remains disabled until an operator explicitly configures it.
PAYMENT_PROVIDER_MODE=disabled
PAYMENT_MOCK_CONFIRMATION_ENABLED=0
WECHAT_PAY_ENABLED=0
ALIPAY_ENABLED=0

# Alipay RSA2 application-public-key mode. Keep key files outside Git.
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
